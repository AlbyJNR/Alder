<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates itself from the GitHub releases (Updates.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: an update CAS downloaded itself installs without the confirm box (Updates.kt) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Continue Watching on the Google TV home (WatchNext.kt) -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <!-- Trailers and recaps the TV's YouTube app or browser should open (Android 11+ hides other apps otherwise) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="vnd.youtube" /></intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/CAS"
        android:usesCleartextTraffic="true">
        <!-- The 16:9 tile is the icon as well as the banner: Fire TV's launcher draws a sideloaded app's tile from
             android:icon, and showed the square icon with grey bars either side while the tile was the banner only. -->
        <!-- Plain http:// as Stremio allows it: self-hosted add-ons (http://192.168.…:7000), debrid proxies and IPTV
             links. Android 9+ blocks it otherwise, and every such add-on and stream failed. -->

        <activity
            android:name=".ProfilesActivity"
            android:banner="@drawable/banner"
            android:icon="@drawable/banner"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:screenOrientation="landscape" />
        <activity android:name=".SearchActivity" android:screenOrientation="landscape" />
        <activity android:name=".PersonActivity" android:screenOrientation="landscape" />
        <activity android:name=".GridActivity" android:screenOrientation="landscape" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".AddonsActivity" android:screenOrientation="landscape" />
        <activity android:name=".DetailsActivity" android:screenOrientation="landscape" />
        <activity android:name=".StreamsActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".PlayerActivity"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout" />
        <receiver android:name=".Updates$Status" android:exported="false" />
    </application>
</manifest>
